QMainWindow {
    background-color: #ffffff;
}

QWidget {
    font-family: Arial, sans-serif;
    color: #1a1a1b;
}

QLabel#titleLabel {
    font-size: 28px;
    font-weight: bold;
}

QLabel#cameraPlaceholder {
    background-color: #000000;
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d3d6da;
    border-radius: 4px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #f3f3f3;
}

QPushButton:pressed {
    background-color: #e5e5e5;
}

QWidget#board {
    background-color: transparent;
}

QLabel#wordCell {
    background-color: #ffffff;
    border: 2px solid #d3d6da;
    font-size: 28px;
    font-weight: bold;
    color: #1a1a1b;
}

QLabel#wordCell[status="filled"] { border: 2px solid #888; }
QLabel#wordCell[status="correct"] { background-color: #6aaa64; color: white; }
QLabel#wordCell[status="present"] { background-color: #c9b458; color: white; }
QLabel#wordCell[status="absent"] { background-color: #787c7e; color: white; }

QLabel#keyboardKey[status="unused"]  { background-color: #d3d6da; color: black; }
QLabel#keyboardKey[status="correct"] { background-color: #6aaa64; color: white; }
QLabel#keyboardKey[status="present"] { background-color: #c9b458; color: white; }
QLabel#keyboardKey[status="absent"]  { background-color: #787c7e; color: white; }

QLineEdit#wordIdInput { border: 1px solid #888; border-radius: 4px; padding: 2px 6px; }
QLabel#resultMessage { font-size: 14px; }
QPushButton#shareButton { padding: 6px 14px; }

QPushButton#helpButton { padding: 4px 10px; }
QLabel#helpPanel { border: 1px solid #ccc; }

QLineEdit#wordIdInput {
    background-color: #ffffff;
    border: 1px solid #d3d6da;
    border-radius: 4px;
    padding: 8px 6px;
    font-size: 14px;
    font-weight: bold;
}